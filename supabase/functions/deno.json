{
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"],
    "strict": true,
    "noImplicitAny": true
  },
  "imports": {
    "@supabase/functions-js": "jsr:@supabase/functions-js@^2"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        "no-unused-vars",
        "require-await",
        "no-explicit-any",
        "ban-ts-comment",
        "no-unversioned-import",
        "no-node-globals",
        "prefer-const",
        "no-dupe-else-if",
        "no-invalid-regexp"
      ]
    }
  },
  "exclude": [
    "**/node_modules",
    "**/.readiness"
  ]
}
