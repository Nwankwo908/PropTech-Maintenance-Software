{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "google.maps"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src", "shared"],
  "exclude": [
    "supabase/functions",
    "node_modules",
    "dist",
    "**/*_test.ts",
    "**/*_test.tsx",
    "**/* 2.ts",
    "**/* 2.tsx",
    "**/* 2.mjs",
    "**/* 2.js"
  ]
}
