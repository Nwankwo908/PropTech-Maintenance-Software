{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "env": {
    "VITE_GA4_MEASUREMENT_ID": "G-V3TZ9DBCGX",
    "VITE_CLARITY_PROJECT_ID": "yctaghhr6q"
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "code" },
        { "type": "query", "key": "state" }
      ],
      "destination": "https://mzpqwuizhiaczxcnmxbt.supabase.co/functions/v1/thumbtack-oauth",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        { "type": "query", "key": "code" },
        { "type": "query", "key": "state" }
      ],
      "destination": "https://mzpqwuizhiaczxcnmxbt.supabase.co/functions/v1/thumbtack-oauth",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/estimate/decision", "destination": "/estimate-decision.html" },
    { "source": "/estimate-decision", "destination": "/estimate-decision.html" },
    {
      "source": "/((?!assets/|favicon\\.png|og-image\\.png|robots\\.txt|sitemap\\.xml|icons\\.svg|figma-assets/|estimate-decision\\.html|terms(?:/index\\.html)?|privacy(?:/index\\.html)?).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
