{
  "name": "proptech-maintenance-software",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sms-simulated": "deno test --cached-only --config supabase/functions/deno.json --no-lock --allow-read supabase/functions/_shared/sms/simulations/userJourneys_test.ts",
    "deploy:status": "node scripts/deploy-status.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:packaging": "bash scripts/readiness/check-packaging.sh",
    "check:frontend-types": "bash scripts/readiness/check-frontend-types.sh",
    "check:backend-types": "bash scripts/readiness/check-backend-types.sh",
    "check:lint": "bash scripts/readiness/check-lint.sh",
    "check:behavior-frontend": "bash scripts/readiness/check-behavior-frontend.sh",
    "check:behavior-backend": "bash scripts/readiness/check-behavior-backend.sh",
    "check:connected-workflows": "bash scripts/readiness/check-connected-workflows.sh",
    "check:readiness": "bash scripts/readiness/run-all.sh",
    "verify:account-privacy": "node scripts/integration-verification/verify-account-privacy.mjs",
    "verify:account-privacy-isolated": "node scripts/integration-verification/verify-account-privacy-isolated.mjs",
    "verify:auth-privacy-remaining": "node scripts/integration-verification/verify-auth-privacy-remaining.mjs",
    "verify:configure-test-access": "node scripts/integration-verification/configure-test-access.mjs --la2-only",
    "verify:maintenance-workflow": "node scripts/integration-verification/verify-maintenance-workflow.mjs",
    "verify:sms-journey": "node scripts/integration-verification/verify-sms-journey.mjs",
    "verify:pilot-remaining-blockers": "node scripts/integration-verification/verify-pilot-remaining-blockers.mjs",
    "verify:emergency-alert": "node scripts/integration-verification/verify-emergency-alert.mjs",
    "verify:onboarding-askulo": "node scripts/integration-verification/verify-onboarding-askulo.mjs",
    "verify:failure-recovery": "node scripts/integration-verification/verify-failure-recovery.mjs",
    "verify:sms-failure-recovery": "node scripts/integration-verification/verify-sms-failure-recovery.mjs",
    "verify:live-ai-workflows": "node scripts/integration-verification/verify-live-ai-workflows.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@supabase/supabase-js": "^2.106.0",
    "@vercel/analytics": "^2.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  }
}
